{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "ItemPreviewAutoSpinning",
  "displayName": "Item Preview Auto Spinning",
  "minMcmVersion": 13,
  "pages": [
    {
      "pageDisplayName": "General",
      "content": [
        {
          "id": "fRotationSpeed:General",
          "text": "Auto-spin speed",
          "type": "slider",
          "help": "Automatic rotation speed. Negative values reverse direction.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "defaultValue": 0.3,
            "min": -10.0,
            "max": 10.0,
            "step": 0.05,
            "formatString": "{2}"
          }
        },
        {
          "id": "fResumeDelaySeconds:General",
          "text": "Resume delay",
          "type": "slider",
          "help": "Seconds before automatic rotation resumes after manual rotation.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "defaultValue": 0.35,
            "min": 0.0,
            "max": 10.0,
            "step": 0.05,
            "formatString": "{2} s"
          }
        },
        {
          "id": "bManualSpinAfterDrag:General",
          "text": "Release spin",
          "type": "toggle",
          "groupControl": 1,
          "help": "Continue spinning briefly after manual rotation.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": true
          }
        },
        {
          "id": "fManualSpinDurationSeconds:General",
          "text": "Release spin duration",
          "type": "slider",
          "groupCondition": 1,
          "groupBehavior": "disable",
          "help": "Seconds for release spin to settle.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "defaultValue": 1.2,
            "min": 0.1,
            "max": 5.0,
            "step": 0.1,
            "formatString": "{1} s"
          }
        },
        {
          "id": "fManualSpinStrength:General",
          "text": "Release spin strength",
          "type": "slider",
          "groupCondition": 1,
          "groupBehavior": "disable",
          "help": "Makes release spin weaker or stronger.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "defaultValue": 1.0,
            "min": 0.0,
            "max": 3.0,
            "step": 0.1,
            "formatString": "{1}"
          }
        },
        {
          "id": "bDebugLogging:General",
          "text": "Debug logging",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": false
          }
        }
      ]
    }
  ]
}
